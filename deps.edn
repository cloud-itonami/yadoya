{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "2ee6dce2ca944decd001f9378868dd703fc3e741"}}
 ;; Frontend deps (shadow-cljs :cljs alias). appkit transitively pulls
 ;; kotoba-ui → liquid-glass-ui → shitsuke — same convention as
 ;; orgs/kotoba-lang/murakumo-studio/deps.edn and
 ;; orgs/cloud-itonami/public-malak/deps.edn. local/root path is relative
 ;; to this repo's checkout location: both the shared west checkout
 ;; orgs/cloud-itonami/yadoya and the orgs/cloud-itonami/_wt-yadoya
 ;; worktree sit one level below orgs/, so ../../kotoba-lang/appkit
 ;; resolves in BOTH locations.
 :aliases
 {:cljs
  {:extra-deps {thheller/shadow-cljs {:mvn/version "2.28.20"}
                reagent/reagent {:mvn/version "1.2.0"}
                io.github.kotoba-lang/appkit {:local/root "../../kotoba-lang/appkit"}}}}}
