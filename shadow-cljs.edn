;; shadow-cljs build for the yadoya (yadoya-ui-b7r4n2xq) appview UI.
;; Mirrors orgs/kotoba-lang/murakumo-studio/shadow-cljs.edn and
;; orgs/cloud-itonami/public-malak/shadow-cljs.edn:
;; CLJS + reagent on kotoba-ui.core + appkit.core (murakumo-studio構成).
{:deps {:aliases [:cljs]}
 :nrepl {:port 9633}

 :builds
 {:app
  {:target :browser
   :output-dir "web/dist/js"
   :asset-path "js"
   :modules {:main {:init-fn cloud-itonami.yadoya.desktop/init!}}}}}
